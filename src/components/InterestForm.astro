---
import { INTEREST_ENDPOINT } from '../config';

interface Props {
  shirtId: string;
  shirtTitle: string;
  sizes: string[];
}

const { shirtId, shirtTitle, sizes } = Astro.props;
---

<!-- Without JS this is a plain POST to Formspree; with JS it submits via fetch and stays on the page. -->
<form class="interest" method="POST" action={INTEREST_ENDPOINT}>
  <input type="hidden" name="shirt" value={shirtId} />
  <!-- Formspree special fields: _subject sets the notification subject, _gotcha is a honeypot. -->
  <input type="hidden" name="_subject" value={`Interest: ${shirtTitle}`} />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

  <fieldset>
    <legend>Size</legend>
    <div class="sizes">
      {
        sizes.map((size, i) => (
          <label>
            <input type="radio" name="size" value={size} required={i === 0} />
            <span>{size}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <label class="email">
    Email
    <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
  </label>

  <button type="submit" class="button">I want one</button>
  <p class="status" role="status" aria-live="polite"></p>
  <p class="small">No payment, no spam. We'll only email you if this shirt goes to print.</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form.interest').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.classList.remove('error');
      status.textContent = 'Sending...';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) {
          // Formspree returns { errors: [{ message, field? }] } on failure.
          const body = await res.json().catch(() => null);
          const messages = body?.errors?.map((e: { message: string }) => e.message).join(' ');
          throw new Error(messages || `HTTP ${res.status}`);
        }
        form.reset();
        status.textContent = "Noted! We'll let you know if it goes to print.";
      } catch (err) {
        status.classList.add('error');
        status.textContent = `Error: ${err instanceof Error ? err.message : 'something went wrong'}. Please try again.`;
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .interest {
    display: grid;
    gap: 1rem;
  }

  fieldset {
    border: 2px solid var(--ink);
    margin: 0;
    padding: 0.5rem 0.75rem 0.75rem;
  }

  legend {
    font: 700 0.9rem var(--mono);
    padding: 0 0.3rem;
  }

  .sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sizes input {
    position: absolute;
    opacity: 0;
  }

  .sizes span {
    display: inline-block;
    min-width: 3rem;
    text-align: center;
    padding: 0.3rem 0.5rem;
    border: 2px solid var(--ink);
    font: 700 0.9rem var(--mono);
    cursor: pointer;
  }

  .sizes input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }

  .sizes input:focus-visible + span {
    outline: 3px dashed var(--accent);
    outline-offset: 2px;
  }

  .email {
    display: grid;
    gap: 0.25rem;
    font: 700 0.9rem var(--mono);
  }

  .email input {
    font: 1rem var(--sans);
    padding: 0.5rem;
    border: 2px solid var(--ink);
    background: #fff;
  }

  .button {
    justify-self: start;
  }

  .status:empty {
    display: none;
  }

  .status {
    font-family: var(--mono);
    margin: 0;
  }

  .status.error {
    color: var(--accent);
  }

  .small {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }
</style>
