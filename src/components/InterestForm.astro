---
import { INTEREST_ACCESS_KEY, INTEREST_EMAIL, INTEREST_ENDPOINT } from '../config';

interface Props {
  shirtId: string;
  shirtTitle: string;
  sizes: string[];
}

const { shirtId, shirtTitle, sizes } = Astro.props;
const subject = `Interest: ${shirtTitle}`;
---

<form
  class="interest"
  method="post"
  action={INTEREST_ENDPOINT || `mailto:${INTEREST_EMAIL}?subject=${encodeURIComponent(subject)}`}
  enctype={INTEREST_ENDPOINT ? undefined : 'text/plain'}
  data-endpoint={INTEREST_ENDPOINT}
  data-email={INTEREST_EMAIL}
  data-subject={subject}
>
  <input type="hidden" name="shirt" value={shirtId} />
  <input type="hidden" name="subject" value={subject} />
  {INTEREST_ACCESS_KEY && <input type="hidden" name="access_key" value={INTEREST_ACCESS_KEY} />}
  <!-- Honeypot: bots fill this, humans don't see it. -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

  <fieldset>
    <legend>Size</legend>
    <div class="sizes">
      {
        sizes.map((size, i) => (
          <label>
            <input type="radio" name="size" value={size} required={i === 0} />
            <span>{size}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <label class="email">
    Email
    <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
  </label>

  <button type="submit" class="button">I want one</button>
  <p class="status" role="status" aria-live="polite"></p>
  <p class="small">No payment, no spam. We'll only email you if this shirt goes to print.</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form.interest').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (data.get('_gotcha')) return;

      const { endpoint, email, subject } = form.dataset;

      if (!endpoint) {
        const body = `Shirt: ${data.get('shirt')}\nSize: ${data.get('size')}\nEmail: ${data.get('email')}`;
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? '')}&body=${encodeURIComponent(body)}`;
        status.textContent = 'Your email app should open with everything filled in. Just hit send.';
        return;
      }

      button.disabled = true;
      status.textContent = 'Sending...';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        form.reset();
        status.textContent = "Noted! We'll let you know if it goes to print.";
      } catch {
        status.textContent = 'Error: something went wrong. Please try again in a moment.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .interest {
    display: grid;
    gap: 1rem;
  }

  fieldset {
    border: 2px solid var(--ink);
    margin: 0;
    padding: 0.5rem 0.75rem 0.75rem;
  }

  legend {
    font: 700 0.9rem var(--mono);
    padding: 0 0.3rem;
  }

  .sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sizes input {
    position: absolute;
    opacity: 0;
  }

  .sizes span {
    display: inline-block;
    min-width: 3rem;
    text-align: center;
    padding: 0.3rem 0.5rem;
    border: 2px solid var(--ink);
    font: 700 0.9rem var(--mono);
    cursor: pointer;
  }

  .sizes input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }

  .sizes input:focus-visible + span {
    outline: 3px dashed var(--accent);
    outline-offset: 2px;
  }

  .email {
    display: grid;
    gap: 0.25rem;
    font: 700 0.9rem var(--mono);
  }

  .email input {
    font: 1rem var(--sans);
    padding: 0.5rem;
    border: 2px solid var(--ink);
    background: #fff;
  }

  .button {
    justify-self: start;
  }

  .status:empty {
    display: none;
  }

  .status {
    font-family: var(--mono);
    margin: 0;
  }

  .small {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }
</style>
