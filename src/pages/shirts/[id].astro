---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ShirtImage from '../../components/ShirtImage.astro';
import InterestForm from '../../components/InterestForm.astro';

export async function getStaticPaths() {
  const shirts = await getCollection('shirts');
  return shirts.map((shirt) => ({ params: { id: shirt.id }, props: { shirt } }));
}

interface Props {
  shirt: CollectionEntry<'shirts'>;
}

const { shirt } = Astro.props;
const { title, tagline, price, sizes, tags, image, imageAlt, design, designAlt } = shirt.data;
const { Content } = await render(shirt);

const full = async (src: typeof image) =>
  src ? (await getImage({ src, width: src.width, format: 'jpg', quality: 90 })).src : undefined;
const imageFull = await full(image);
const designFull = await full(design);
---

<Layout title={title} description={tagline}>
  <p class="back"><a href="/#shirts">&lt; Back to the catalogue</a></p>
  <div class="layout">
    <div class="media">
      <div class="window">
        <div class="window-title"><span>{title}</span></div>
        <div class="window-body">
          {
            imageFull ? (
              <a class="zoom" href={imageFull} data-alt={imageAlt ?? `${title} t-shirt`} title="Click to enlarge">
                <ShirtImage shirt={shirt} loading="eager" />
              </a>
            ) : (
              <ShirtImage shirt={shirt} loading="eager" />
            )
          }
        </div>
      </div>
      {
        design && (
          <div class="window">
            <div class="window-title"><span>The print</span></div>
            <div class="window-body">
              <a class="zoom" href={designFull} data-alt={designAlt ?? `${title} print artwork`} title="Click to enlarge">
                <Image
                  class="design"
                  src={design}
                  alt={designAlt ?? `${title} print artwork`}
                  widths={[600, 1000, 1600]}
                  sizes="(max-width: 760px) 95vw, 550px"
                />
              </a>
            </div>
          </div>
        )
      }
    </div>

    <div class="details">
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
      <p class="price">&pound;{price.toFixed(2)} <span>(estimated)</span></p>
      <p>{tags.map((t) => <span class="tag">{t}</span>)}</p>
      <div class="story"><Content /></div>

      <div class="window">
        <div class="window-title"><span>Express interest</span></div>
        <div class="window-body">
          <InterestForm shirtId={shirt.id} shirtTitle={title} sizes={sizes} />
        </div>
      </div>
    </div>
  </div>

  <dialog class="lightbox" aria-label="Enlarged image">
    <img alt="" />
    <button type="button" class="close" aria-label="Close">X</button>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dialog.querySelector('img')!;
  document.querySelectorAll<HTMLAnchorElement>('a.zoom').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      dialog.showModal();
    });
  });
  // Any click (backdrop, image or close button) closes it; Esc is handled by <dialog>.
  dialog.addEventListener('click', () => dialog.close());
</script>

<style>
  .zoom {
    display: block;
    cursor: zoom-in;
  }

  .lightbox {
    padding: 0;
    border: 2px solid var(--ink, #000);
    background: #111;
    max-width: 95vw;
    max-height: 95vh;
    cursor: zoom-out;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }

  .lightbox img {
    display: block;
    max-width: 95vw;
    max-height: calc(95vh - 4px);
    width: auto;
    height: auto;
  }

  .lightbox .close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font: 700 1rem var(--mono);
    background: #fff;
    border: 2px solid #000;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
  }

  .back {
    font-family: var(--mono);
    margin-top: 0;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  .media {
    display: grid;
    gap: 1.5rem;
  }

  .design {
    display: block;
    width: 100%;
    height: auto;
  }

  h1 {
    margin-top: 0;
  }

  .tagline {
    font-size: 1.15rem;
  }

  .price {
    font: 700 1.3rem var(--mono);
  }

  .price span {
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .story {
    margin-bottom: 1.5rem;
  }
</style>
