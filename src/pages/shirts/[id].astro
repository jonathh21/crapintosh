---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ShirtMockup from '../../components/ShirtMockup.astro';
import InterestForm from '../../components/InterestForm.astro';

export async function getStaticPaths() {
  const shirts = await getCollection('shirts');
  return shirts.map((shirt) => ({ params: { id: shirt.id }, props: { shirt } }));
}

interface Props {
  shirt: CollectionEntry<'shirts'>;
}

const { shirt } = Astro.props;
const { title, tagline, print, shirtColour, inkColour, price, sizes, tags } = shirt.data;
const { Content } = await render(shirt);
---

<Layout title={title} description={tagline}>
  <p class="back"><a href="/#shirts">&lt; Back to the catalogue</a></p>
  <div class="layout">
    <div class="window">
      <div class="window-title"><span>{title}</span></div>
      <div class="window-body">
        <ShirtMockup print={print} shirtColour={shirtColour} inkColour={inkColour} label={`${title} t-shirt`} />
      </div>
    </div>

    <div class="details">
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
      <p class="price">&pound;{price.toFixed(2)} <span>(estimated)</span></p>
      <p>{tags.map((t) => <span class="tag">{t}</span>)}</p>
      <div class="story"><Content /></div>

      <div class="window">
        <div class="window-title"><span>Express interest</span></div>
        <div class="window-body">
          <InterestForm shirtId={shirt.id} shirtTitle={title} sizes={sizes} />
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .back {
    font-family: var(--mono);
    margin-top: 0;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  h1 {
    margin-top: 0;
  }

  .tagline {
    font-size: 1.15rem;
  }

  .price {
    font: 700 1.3rem var(--mono);
  }

  .price span {
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .story {
    margin-bottom: 1.5rem;
  }
</style>
