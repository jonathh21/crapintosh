---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="What Crapintosh is and how the interest list works.">
  <div class="window">
    <div class="window-title"><span>About This Crapintosh</span></div>
    <div class="window-body">
      <h1>About</h1>
      <p>
        Crapintosh makes t-shirts for people who own more than one serial cable and know why. The designs
        are technical, retro, geeky or deliberately obscure.
      </p>
      <h2>How it works</h2>
      <ol>
        <li>Find a shirt you like.</li>
        <li>Pick your size and leave your email under <strong>I want one</strong>.</li>
        <li>Once enough people are interested, it goes to print and you get first dibs.</li>
      </ol>
      <p>No payment is taken and your email is only used to tell you about that shirt.</p>
    </div>
  </div>
</Layout>
