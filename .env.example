# Form service endpoint that receives "express interest" submissions.
# e.g. https://formspree.io/f/abcdwxyz  or  https://api.web3forms.com/submit
PUBLIC_INTEREST_ENDPOINT=

# Only needed for services like Web3Forms that require an access_key field.
PUBLIC_INTEREST_ACCESS_KEY=

# Used for the mailto fallback when no endpoint is set.
PUBLIC_INTEREST_EMAIL=hello@crapintosh.co.uk
